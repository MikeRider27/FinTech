# Copia este archivo a .env y ajusta los valores. Todos tienen un valor por defecto.

# --- Entorno ---
# En "production" el backend no arranca si SECRET_KEY conserva el valor por defecto
ENVIRONMENT=development

# --- PostgreSQL ---
POSTGRES_USER=fintech
POSTGRES_PASSWORD=fintech
POSTGRES_DB=fintech

# --- Seguridad ---
# Genera una clave con: openssl rand -hex 32
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Reglas de negocio ---
SUPPORTED_CURRENCIES=USD,EUR,MXN,COP,PEN,CLP,ARS
MAX_TRANSACTION_AMOUNT=1000000.00

# --- Red ---
CORS_ORIGINS=http://localhost:3500,http://localhost:5173
FRONTEND_PORT=3500
BACKEND_PORT=8000
DB_PORT=5433
